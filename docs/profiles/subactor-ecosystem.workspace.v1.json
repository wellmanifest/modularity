  "policies": {
    "unknownFields": "reject",
    "cycles": "reject",
    "layerDirection": "higher-to-same-or-lower",
    "contractOwnership": "single-exporter",
    "stateOwnership": "single-writer",
    "authority": "external-reference-only",
    "twinAuthority": "observational-only",
    "llmAuthority": "propose-only",
    "allowDeprecated": false
  },
  "analysisScope": {
    "includePaths": [
      "docs/MODULARITY.md",
      "docs/profiles/**",
      "docs/schemas/**"
    ],
    "excludePaths": [
      ".intent/**"
    ],
    "managedPaths": [
      ".governance/**"
    ],
    "generatedPaths": [
      "docs/generated/**"
    ],
    "llm": {
      "inputPolicy": "intent-diff-and-findings",
      "maxPromptTokens": 32000,
      "maxFindingsPerBatch": 40,
      "wholeGraphPolicy": "reject",
      "requireProvenance": true
    }
  },
  "conformance": {
    "levels": [
      "document",
      "graph",
      "standards"
    ],
    "commands": [
      [
        "python",
        "-m",
        "modularity",
        "docs/profiles/subactor-ecosystem.workspace.v1.json",
        "--format",
        "json"
      ],
      [
        "python3",
        "../../wellmanifest/dsl/src/dsl_check.py",
        "validate",
        "--root",
        ".",
        "docs/dsl-manifest.json"
      ]
    ]
  }
}
